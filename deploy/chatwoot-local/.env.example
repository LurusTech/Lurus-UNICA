# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Generate the two secrets with:
#   openssl rand -hex 64   # SECRET_KEY_BASE
#   openssl rand -hex 16   # POSTGRES_PASSWORD

SECRET_KEY_BASE=<openssl rand -hex 64>
POSTGRES_PASSWORD=<openssl rand -hex 16>

# The address a browser uses to reach Chatwoot. On WSL this is the WSL IP,
# which changes when WSL restarts — `wsl hostname -I`. Chatwoot only builds
# links from it, so a stale value breaks generated URLs, not the UI itself.
FRONTEND_URL=http://127.0.0.1:3400

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker

POSTGRES_HOST=postgres
POSTGRES_USERNAME=chatwoot
POSTGRES_DATABASE=chatwoot_production
REDIS_URL=redis://redis:6379

RAILS_LOG_TO_STDOUT=true
ACTIVE_STORAGE_SERVICE=local
# Signup stays closed: agents are provisioned, not self-registered.
ENABLE_ACCOUNT_SIGNUP=false
WEB_CONCURRENCY=0
RAILS_MAX_THREADS=25
SIDEKIQ_CONCURRENCY=5
