# Dify preview stack configuration. Copy to .env and edit.
#
# DIFY_PUBLIC_URL must be the address a browser and the router will actually use.
# Dify bakes it into the console's API calls, so a mismatch shows up as a console
# that loads but cannot log in.

# --- local WSL ---
DIFY_PUBLIC_URL=http://localhost:3402
DIFY_PORT=3402
DIFY_DATA_DIR=/data/unica-dify
POSTGRES_PORT=5433

# --- remote preview host: use the tailnet address instead ---
# DIFY_PUBLIC_URL=http://100.122.83.20:3402

POSTGRES_USER=dify
POSTGRES_DB=dify_db

# Replace every secret below before using this anywhere reachable.
#   openssl rand -hex 16
POSTGRES_PASSWORD=262366c174474c6006ee00b75d6830ad
SANDBOX_API_KEY=466d7d73b24e98370440d53b72dbf90a
DIFY_INNER_API_KEY=d4afb53d65db920a67e2b266e22f50dc
#   openssl rand -base64 42
DIFY_SECRET_KEY=RwrSceUVbJ0n/GRbN1gE/P6xwdoqbslHnDeYn5eJvLlEran9Dnm+7XBV
