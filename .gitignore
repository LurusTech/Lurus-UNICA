# Secrets - never commit real credentials
deploy/secrets/*-real.yaml
deploy/secrets/*-prod.yaml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
bin/
dist/
*.exe
*.dll
*.so
*.dylib

# Go
vendor/

# Logs
*.log

# Temp
tmp/

# Environment files (preview credentials)
.env
.env.*

# evalset run artifacts. The pass/fail baseline (doc/eval-baseline.json) IS
# committed — it is the reference every later run is compared against; only the
# verbose per-run report, which embeds full answer text, is transient.
doc/eval-report-*.json
