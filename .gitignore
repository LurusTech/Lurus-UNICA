# Secrets - never commit real credentials
deploy/secrets/*-real.yaml
deploy/secrets/*-prod.yaml

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Build artifacts
bin/
dist/
*.exe
*.dll
*.so
*.dylib

# Go
vendor/

# Logs
*.log

# Temp
tmp/

# Environment files (preview credentials)
.env
.env.*
# Templates carry no real credentials and must ship with the compose files.
!.env.example

# evalset run artifacts. The pass/fail baseline (doc/eval-baseline.json) IS
# committed — it is the reference every later run is compared against; only the
# verbose per-run report, which embeds full answer text, is transient.
doc/eval-report-*.json

# Ad-hoc screenshots dropped at the repo root
ScreenShot_*.png

# promptaudit writes a verbatim backup of every live prompt next to wherever it runs
prompt-backup-*.json

